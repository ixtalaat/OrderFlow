{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Enrich": [
      "FromLogContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AdminSeed": {
    "Email": "admin@orderflow.com",
    "FullName": "OrderFlow Admin"
  },
  "Accounting": {
    "Provider": "Fake",
    "BaseUrl": "http://localhost:5099/",
    "InvoicesPath": "api/invoices",
    "TimeoutSeconds": 10,
    "RetryCount": 2
  },
  "Telemetry": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "OrderFlow.Api",
    "Audience": "OrderFlow.Client",
    "ExpirationMinutes": 15
  }
}
