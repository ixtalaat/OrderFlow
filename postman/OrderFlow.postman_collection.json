{
  "info": {
    "_postman_id": "orderflow-api",
    "name": "OrderFlow API",
    "description": "OrderFlow authentication, Epic 2 customer-management, and Epic 3 product-catalog requests. Select the OrderFlow Local environment before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "apiVersion",
      "value": "v1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"fullName\": \"Postman Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Registers a customer through the public authentication endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns a successful response', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Logs in and stores the returned JWT as customerToken. Copy the token to jwtToken when using a sales or admin account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns a token', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "if (pm.response.code === 200) { pm.environment.set('customerToken', pm.response.json().accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Admin Authorization Check",
          "request": {
            "method": "GET",
            "header": [],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/auth/admin",
            "description": "Requires a JWT for a user with the Admin role."
          }
        }
      ]
    },
    {
      "name": "Customers — Sales/Admin",
      "description": "These requests require jwtToken from a SalesEmployee or Admin account.",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Managed Customer\",\n  \"email\": \"managed-{{$randomUUID}}@example.com\",\n  \"password\": \"Password@123\",\n  \"phoneNumber\": \"+1234567890\",\n  \"address\": \"123 Main Street\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/customers",
            "description": "Creates an Identity customer user and customer profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Customer created', function () { pm.expect(pm.response.code).to.equal(201); });",
                  "if (pm.response.code === 201) { pm.environment.set('customerId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers?searchTerm={{searchTerm}}&isActive={{isActive}}&pageNumber={{pageNumber}}&pageSize={{pageSize}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ],
              "query": [
                {
                  "key": "searchTerm",
                  "value": "{{searchTerm}}"
                },
                {
                  "key": "isActive",
                  "value": "{{isActive}}"
                },
                {
                  "key": "pageNumber",
                  "value": "{{pageNumber}}"
                },
                {
                  "key": "pageSize",
                  "value": "{{pageSize}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Customer By ID",
          "request": {
            "method": "GET",
            "header": [],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Customer\",\n  \"phoneNumber\": \"+1987654321\",\n  \"address\": \"456 Updated Avenue\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "Deactivate Customer",
          "request": {
            "method": "PATCH",
            "header": [],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/deactivate"
          }
        },
        {
          "name": "Activate Customer",
          "request": {
            "method": "PATCH",
            "header": [],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/activate"
          }
        }
      ]
    },
    {
      "name": "Customers — Customer Role",
      "description": "These requests use customerToken and demonstrate customer-owned access.",
      "item": [
        {
          "name": "Get Current Customer",
          "request": {
            "method": "GET",
            "header": [],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/customers/me"
          }
        },
        {
          "name": "Get Own Customer By ID",
          "request": {
            "method": "GET",
            "header": [],
            "authentication": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}",
            "description": "Only succeeds when customerId belongs to the authenticated customer."
          }
        }
      ]
    },
