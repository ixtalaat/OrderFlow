# Copy to .env and fill in the secrets. Never commit .env.
# SQL Server sa password: 8-128 chars, 3 of: upper, lower, digit, symbol.
SA_PASSWORD=OrderFlow123!
# JWT signing key: at least 32 characters.
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_EMAIL=admin@orderflow.com
ADMIN_PASSWORD=Admin123!
ADMIN_FULLNAME=OrderFlow Admin
